// ============================================================================
// Marketing Automation Enums & Models
// ============================================================================

enum Platform {
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  X
}

enum PostStatus {
  BACKLOG
  IN_PROGRESS
  AWAITING_APPROVAL
  SCHEDULED
  POSTED
}

enum PostFormat {
  SINGLE_IMAGE
  VIDEO
  CAROUSEL
}

/// Stores the monthly baseline and compound growth goals.
model MonthlyTarget {
  id                 String        @id @default(uuid()) @db.Uuid
  clientId           String        @map("client_id") @db.Uuid
  monthYear          String        @map("month_year") @db.VarChar(50)
  postsPlanned       Int           @map("posts_planned")
  impressionsTarget  Int           @map("impressions_target")
  reachTarget        Int           @map("reach_target")
  avgErTarget        Float         @map("avg_er_target")
  linkClicksTarget   Int           @map("link_clicks_target")
  demoRequestsTarget Int           @map("demo_requests_target")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       organizations @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clientId])
  @@index([monthYear])
  @@map("monthly_targets")
}

/// Powers the Kanban board and tracks AI workflow states.
model Post {
  id                    String         @id @default(uuid()) @db.Uuid
  clientId              String         @map("client_id") @db.Uuid
  platform              Platform
  externalPostId        String?        @map("external_post_id") @db.VarChar(255)
  status                PostStatus     @default(BACKLOG)
  contentPillar         String         @map("content_pillar") @db.VarChar(255)
  topic                 String         @db.VarChar(255)
  format                PostFormat
  caption               String         @db.Text
  permalink             String?        @db.Text
  scheduledDate         DateTime?      @map("scheduled_date") @db.Timestamptz(6)
  aiCost                Float?         @map("ai_cost")
  regenerationRequested Boolean        @default(false) @map("regeneration_requested")
  imageChangeRequested  Boolean        @default(false) @map("image_change_requested")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          organizations  @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  analytics             PostAnalytics?

  @@index([clientId])
  @@index([status])
  @@index([platform])
  @@index([scheduledDate])
  @@map("posts")
}

/// Frequent metadata updates triggered by n8n webhooks.
model PostAnalytics {
  id              String   @id @default(uuid()) @db.Uuid
  postId          String   @unique @map("post_id") @db.Uuid
  impressions     Int      @default(0)
  reach           Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  saves           Int      @default(0)
  totalEngagement Int      @default(0) @map("total_engagement")
  engagementRate  Float    @default(0.0) @map("engagement_rate")
  profileVisits   Int      @default(0) @map("profile_visits")
  linkClicks      Int      @default(0) @map("link_clicks")
  lastUpdated     DateTime @default(now()) @updatedAt @map("last_updated") @db.Timestamptz(6)

  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([postId])
  @@map("post_analytics")
}

/// Weekly automated "So-What?" reports generated by the LLM.
model AiInsight {
  id            String        @id @default(uuid()) @db.Uuid
  clientId      String        @map("client_id") @db.Uuid
  insightText   String        @map("insight_text") @db.Text
  category      String        @db.VarChar(255)
  dateGenerated DateTime      @default(now()) @map("date_generated") @db.Timestamptz(6)

  organization  organizations @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clientId])
  @@index([dateGenerated])
  @@map("ai_insights")
}

// ---------------------------------------------------------------------------
// Marketing Campaign & Training Enums
// ---------------------------------------------------------------------------

enum MarketingPlatform {
  LINKEDIN
  X
  META
}

enum SchedulingMode {
  MANUAL
  AI_AUTO
}

enum MarketingCampaignStatus {
  DRAFT
  TRAINING
  ACTIVE
  PAUSED
  COMPLETED
}

// ---------------------------------------------------------------------------
// Marketing Campaign & Training Models
// ---------------------------------------------------------------------------

/// Core marketing campaign entity
model MarketingCampaign {
  id             String                  @id @default(uuid()) @db.Uuid
  clientId       String                  @map("client_id") @db.Uuid
  name           String                  @db.VarChar(255)
  platform       MarketingPlatform[]
  status         MarketingCampaignStatus @default(TRAINING)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client         organizations           @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  knowledgeBase  ClientKnowledge[]
  trainingConfig AiTrainingConfig?

  @@index([clientId])
  @@index([status])
  @@map("marketing_campaigns")
}

/// Stores uploaded brand context, past top posts, or scraped URLs
model ClientKnowledge {
  id            String             @id @default(uuid()) @db.Uuid
  clientId      String             @map("client_id") @db.Uuid
  campaignId    String?            @map("campaign_id") @db.Uuid
  fileName      String             @map("file_name") @db.VarChar(255)
  fileType      String             @map("file_type") @db.VarChar(50)
  extractedText String             @map("extracted_text") @db.Text
  websiteUrl    String?            @map("website_url") @db.VarChar(500)
  uploadDate    DateTime           @default(now()) @map("upload_date") @db.Timestamptz(6)

  client        organizations      @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campaign      MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clientId])
  @@index([campaignId])
  @@map("client_knowledge")
}

/// Controls the autonomous AI training period, schedule, and approval mode
model AiTrainingConfig {
  id                            String            @id @default(uuid()) @db.Uuid
  clientId                      String            @map("client_id") @db.Uuid
  campaignId                    String            @unique @map("campaign_id") @db.Uuid
  schedulingMode                SchedulingMode    @map("scheduling_mode")
  postsPerWeek                  Int?              @default(3) @map("posts_per_week")
  manualSchedulePath            String?           @map("manual_schedule_path") @db.VarChar(500)
  trainingPeriodDays            Int               @map("training_period_days")
  trainingModeUntil             DateTime          @map("training_mode_until") @db.Timestamptz(6)
  requireApprovalDuringTraining Boolean           @default(true) @map("require_approval_during_training")
  autoPublishAfterTraining      Boolean           @default(false) @map("auto_publish_after_training")
  createdAt                     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client                        organizations     @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campaign                      MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clientId])
  @@map("ai_training_configs")
}

/// Stores negative constraints and creative feedback rules learned from marketer edits
model ClientFeedbackRules {
  id           String        @id @default(uuid()) @db.Uuid
  clientId     String        @map("client_id") @db.Uuid
  ruleText     String        @map("rule_text") @db.Text
  sourcePostId String?       @map("source_post_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  client       organizations @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clientId])
  @@map("client_feedback_rules")
}
