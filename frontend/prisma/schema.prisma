generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model business_profiles {
  id                     String        @id(map: "pk_business_profiles") @db.Uuid
  organization_id        String        @unique(map: "ix_business_profiles_organization_id") @db.Uuid
  company_name           String        @db.VarChar(255)
  industry               String?       @db.VarChar(255)
  target_icp_description String?
  value_proposition      String?
  website_url            String?       @db.VarChar(500)
  created_at             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime      @default(now()) @db.Timestamptz(6)
  organizations          organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_business_profiles_organization_id_organizations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model call_records {
  id                                                String        @id @db.Uuid
  organization_id                                   String        @db.Uuid
  contact_id                                        String?       @db.Uuid
  lead_id                                           String?       @db.Uuid
  campaign_id                                       String?       @db.Uuid
  call_id                                           String        @unique(map: "ix_call_records_call_id") @db.VarChar(100)
  agent_id                                          String        @db.VarChar(100)
  direction                                         String        @default("inbound") @db.VarChar(20)
  call_status                                       String        @default("ended") @db.VarChar(50)
  call_outcome                                      String?       @db.VarChar(50)
  caller_phone                                      String?       @db.VarChar(50)
  to_phone                                          String?       @db.VarChar(50)
  duration_ms                                       Int?
  disconnection_reason                              String?       @db.VarChar(100)
  summary                                           String?
  transcript                                        String?
  collected_variables                               Json?         @db.Json
  call_analysis                                     Json?         @db.Json
  metadata_json                                     Json?         @db.Json
  followup_status                                   String        @default("none") @db.VarChar(50)
  followup_reason                                   String?       @db.VarChar(255)
  followup_email_id                                 String?       @db.Uuid
  followup_idempotency_key                          String?       @unique(map: "ix_call_records_followup_idempotency_key") @db.VarChar(255)
  started_at                                        DateTime?     @db.Timestamptz(6)
  ended_at                                          DateTime?     @db.Timestamptz(6)
  analyzed_at                                       DateTime?     @db.Timestamptz(6)
  created_at                                        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime      @default(now()) @db.Timestamptz(6)
  campaigns                                         campaigns?    @relation(fields: [campaign_id], references: [id], onUpdate: NoAction)
  contacts                                          contacts?     @relation(fields: [contact_id], references: [id], onUpdate: NoAction)
  outreach_call_records_followup_email_idTooutreach outreach?     @relation("call_records_followup_email_idTooutreach", fields: [followup_email_id], references: [id], onUpdate: NoAction)
  leads                                             leads?        @relation(fields: [lead_id], references: [id], onUpdate: NoAction)
  organizations                                     organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  outreach_outreach_call_record_idTocall_records    outreach[]    @relation("outreach_call_record_idTocall_records")

  @@index([agent_id], map: "ix_call_records_agent_id")
  @@index([call_outcome], map: "ix_call_records_call_outcome")
  @@index([campaign_id], map: "ix_call_records_campaign_id")
  @@index([contact_id], map: "ix_call_records_contact_id")
  @@index([followup_email_id], map: "ix_call_records_followup_email_id")
  @@index([followup_status], map: "ix_call_records_followup_status")
  @@index([lead_id], map: "ix_call_records_lead_id")
  @@index([organization_id, call_id], map: "ix_call_records_org_call")
  @@index([organization_id, call_outcome], map: "ix_call_records_org_outcome")
  @@index([organization_id], map: "ix_call_records_organization_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model campaign_contacts {
  id                String     @id(map: "pk_campaign_contacts") @db.Uuid
  campaign_id       String     @db.Uuid
  contact_id        String     @db.Uuid
  enrollment_status String     @default("queued") @db.VarChar(50)
  current_step      Int        @default(0)
  enrolled_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at        DateTime   @default(now()) @db.Timestamptz(6)
  campaigns         campaigns  @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_campaign_contacts_campaign_id_campaigns")
  contacts          contacts   @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_campaign_contacts_contact_id_contacts")
  outreach          outreach[]

  @@unique([campaign_id, contact_id], map: "uq_campaign_contact")
  @@index([campaign_id], map: "ix_campaign_contacts_campaign_id")
  @@index([contact_id], map: "ix_campaign_contacts_contact_id")
  @@index([enrollment_status], map: "ix_campaign_contacts_enrollment_status")
}

