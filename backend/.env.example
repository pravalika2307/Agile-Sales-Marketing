# Agile Sales & Marketing Backend Environment Configuration
PROJECT_NAME="Agile Sales & Marketing API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agile_sales_marketing

# Authentication & Security
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate-strong-random-secret-at-least-32-chars>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# HubSpot Integration
# Replace with your HubSpot Personal Access Key (PAK) or Private App Token
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here
HUBSPOT_BASE_URL="https://api.hubapi.com"
HUBSPOT_TIMEOUT_SECONDS=10.0
 
# Email Provider Configuration ('mock', 'ses', 'resend', or leave empty for auto-detection)
EMAIL_PROVIDER_TYPE=mock
EMAIL_FROM_ADDRESS=outreach@example.com
EMAIL_FROM_NAME="Agile Sales & Marketing"

# Resend Email Configuration (Optional)
RESEND_API_KEY=re_your_api_key_here
RESEND_BASE_URL="https://api.resend.com"
RESEND_TIMEOUT_SECONDS=10.0

# AWS SES Email Configuration (Adapted from Agile backend)
AWS_SES_REGION=us-east-2
AWS_SES_CONFIGURATION_SET=sales-marketing-config-set
AWS_SES_FROM_EMAIL=outreach@example.com
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Retell AI Voice Configuration (Outbound SDR)
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here
RETELL_LLM_ID=your_retell_llm_id_here
RETELL_FROM_NUMBER=+16416818482

# Retell AI Voice Configuration (Inbound Assistant)
RETELL_INBOUND_AGENT_ID=your_retell_inbound_agent_id_here
RETELL_INBOUND_LLM_ID=your_retell_inbound_llm_id_here
RETELL_INBOUND_CF_AGENT_ID=your_retell_inbound_cf_agent_id_here
RETELL_INBOUND_CONVERSATION_FLOW_ID=your_retell_inbound_conversation_flow_id_here

# Twilio SMS Configuration
# Fail-closed safety: TWILIO_ENABLED defaults to false. Real sending remains strictly disabled.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
TWILIO_ENABLED=false
TWILIO_ALLOW_LIVE_SENDING=false

# Microsoft Graph Configuration (Support Mailbox Inbound Ingestion)
# Fail-closed safety: MICROSOFT_GRAPH_ENABLED defaults to false. Live mailbox sync remains disabled.
MICROSOFT_GRAPH_TENANT_ID=your_microsoft_tenant_id_here
MICROSOFT_GRAPH_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_GRAPH_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_GRAPH_SUPPORT_MAILBOX=support@agilereceivables.com
MICROSOFT_GRAPH_ENABLED=false
MICROSOFT_GRAPH_AUTH_FLOW=client_credentials
MICROSOFT_GRAPH_TIMEOUT_SECONDS=15.0
MICROSOFT_GRAPH_MAX_MESSAGES_PER_PAGE=50
# Automatic background sync settings (Fail-closed safety: defaults to false)
MICROSOFT_GRAPH_AUTO_SYNC_ENABLED=false
MICROSOFT_GRAPH_SYNC_INTERVAL_MINUTES=10
MICROSOFT_GRAPH_SYNC_LOCK_TIMEOUT_SECONDS=900
MICROSOFT_GRAPH_PRIMARY_ORG_ID=your_primary_organization_uuid_here


